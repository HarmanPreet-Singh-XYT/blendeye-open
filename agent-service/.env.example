# ==============================================================================
# BlendEye — Python Agent Service Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud AI (Required per Hackathon Rules)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here
# Set true to use Vertex AI authentication instead of AI Studio API key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# ClickHouse Database (Required Partner Track Integration)
# ------------------------------------------------------------------------------
# Defaults target local container from `docker compose up clickhouse`:
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=devpassword
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

# For ClickHouse Cloud:
# CLICKHOUSE_HOST=your-cluster.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your_cloud_password
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_SECURE=true

# ------------------------------------------------------------------------------
# Parallel Web Systems (Partner Track Integration — Real-Time Search Grounding)
# ------------------------------------------------------------------------------
# Official parallel-web SDK runtime search for location scouting & municipal fees
PARALLEL_API_KEY=your_parallel_api_key_here

# ------------------------------------------------------------------------------
# Grafana Labs (Partner Track Integration — Observability & MCP)
# ------------------------------------------------------------------------------
# Official mcp-grafana server and PromQL cloud monitoring
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_service_account_token_here

# Grafana Cloud Prometheus remote_write — used by the Alloy sidecar in docker compose,
# not by the Python service itself. Add here for reference parity with root .env.example.
# Find both at: Grafana Cloud → Connections → Add new connection → Prometheus → Remote Write
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-prod-region-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USERNAME=your_prometheus_instance_id_here


# ------------------------------------------------------------------------------
# Supabase Cloud Storage (Persists rendered clips & audio to cinema_assets bucket)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key

# ------------------------------------------------------------------------------
# CORS & Runtime Environment
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
