# ==============================================================================
# BlendEye — Root Environment Configuration Template
# ==============================================================================
# This file documents all environment variables used across the monorepo stack:
# - agent-service (Python 3.12 / FastAPI + Google Cloud AI + ClickHouse + Parallel Web + Grafana)
# - web (Next.js 16 App Router + Supabase)
# - docker compose (local ClickHouse container)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud AI Platform (Required per Hackathon Rules)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# ClickHouse Database (Required Partner Track Integration)
# ------------------------------------------------------------------------------
# Local container via `docker compose up clickhouse`:
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=devpassword
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

# For ClickHouse Cloud instead:
# CLICKHOUSE_HOST=your-instance.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your_cloud_password
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_SECURE=true

# ------------------------------------------------------------------------------
# Parallel Web Systems (Partner Track Integration — Search & Grounding)
# ------------------------------------------------------------------------------
PARALLEL_API_KEY=your_parallel_api_key_here

# ------------------------------------------------------------------------------
# Grafana Labs (Partner Track Integration — Observability & MCP)
# ------------------------------------------------------------------------------
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_token_here

# Grafana Cloud Prometheus remote_write (used by the Grafana Alloy sidecar in docker compose)
# Find both values at: Grafana Cloud → Connections → Add new connection → Prometheus → Remote Write
#   URL example:      https://prometheus-prod-32-prod-ca-east-0.grafana.net/api/prom/push
#   Username example: 3571839  (numeric instance ID — NOT the service account name)
# Password reuses GRAFANA_SERVICE_ACCOUNT_TOKEN; ensure it has the "Metrics Publisher" role.
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-prod-region-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USERNAME=your_prometheus_instance_id_here


# ------------------------------------------------------------------------------
# Supabase (Auth & Cloud State — REQUIRED)
# ------------------------------------------------------------------------------
# BlendEye is cloud-only and login-gated: all project data lives in Supabase and
# nothing is persisted in the browser. Without these, sign-in and the studio are
# both unavailable. Run supabase/schema.sql once to provision the tables + RLS.
# Upgrading an existing DB? Also run supabase/cleanup-guest-data.sql.
# Used by Next.js frontend:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key

# Used by agent-service sidecar to persist Veo videos / audio to cinema_assets bucket:
SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------------------------
# Networking & Microservice Endpoints
# ------------------------------------------------------------------------------
AGENT_SERVICE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
